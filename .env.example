# --- Copia questo file in .env e compilalo ---

# URL della tua istanza Crafty (quello che usi nel browser)
CRAFTY_URL=https://192.168.1.10:8443
# Token API: in Crafty -> ingranaggio in alto a destra -> il tuo utente -> API Keys -> Generate
# (serve un utente con permessi di amministratore / superuser)
CRAFTY_TOKEN=
# Crafty usa un certificato autofirmato: lascia false
CRAFTY_VERIFY_SSL=false

# Dove si trovano le cartelle dei server, VISTE DA QUESTO CONTAINER.
# Deve essere lo stesso volume montato da Crafty, ma con permesso di scrittura.
CRAFTY_SERVERS_DIR=/mnt/crafty/servers
# Traduzione dei path: "<path visto da Crafty>=<path visto da Crafty Medic>"
CRAFTY_MEDIC_PATH_MAP=/crafty/servers=/mnt/crafty/servers

# Cartella interna (quarantena, backup, log operazioni)
CRAFTY_MEDIC_DATA_DIR=/data
# Crea un backup di mods/, plugins/ e configurazioni prima di ogni riparazione
CRAFTY_MEDIC_BACKUP=true
# Se dopo la riparazione il server non riparte, rimette tutto a posto
CRAFTY_MEDIC_AUTO_ROLLBACK=true
# Quanti secondi aspettare l'avvio prima di dichiarare fallita la riparazione
CRAFTY_MEDIC_BOOT_WAIT=90
# Abilita la ricerca aggiornamenti su Modrinth (nessuna chiave richiesta)
CRAFTY_MEDIC_UPDATER=true

# Interfaccia web
CRAFTY_MEDIC_HOST=0.0.0.0
CRAFTY_MEDIC_PORT=8765

# Solo per provare senza un Crafty vero: server e crash finti
CRAFTY_MEDIC_DEMO=false
